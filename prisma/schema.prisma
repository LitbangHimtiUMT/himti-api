generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id @default(uuid()) @db.VarChar(110)
  name                  String                @db.VarChar(255)
  email                 String                @unique @db.VarChar(110)
  password              String                @db.VarChar(110)
  role                  Role                  @default(ADMIN)
  nim                   String?               @db.VarChar(20)
  memberId              String?               @unique @map("member_id") @db.VarChar(110)
  Attendance            Attendance[]
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamp(0)
  isLogin               Boolean               @default(false) @map("is_login")
  photo                 String?               @db.VarChar(255)
  Member                Member?               @relation(fields: [memberId], references: [id], onDelete: NoAction)
  mentor                Mentor?               @relation
  Point                 Point[]
  UserFCM               UserFCM[]
  NotificationHistory   NotificationHistory[]
  Classes               Class[]
  ClassParticipant      ClassParticipant[]
  CompletedModule       CompletedModule[]
  CompletedClass        CompletedClass[]
  Certificate           Certificate[]
  submissionParticipant Submission[]          @relation("submission_participant")
  submissionMentor      Submission[]          @relation("submission_mentor")
  Transaction           Transaction[]
  EventRegistration     EventRegistration[]
  History               History[]
  ClassMentor           ClassMentor[]
  TicketSuport          TicketSuport[]

  @@index([memberId], map: "user_fk_1")
  @@index([email], map: "user_fk_2")
  @@map("user")
}

model UserFCM {
  id       String @id @unique @default(uuid())
  userId   String @map("user_id") @db.VarChar(110)
  fcmToken String @map("fcm_token") @db.VarChar(255)
  User     User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "user_fcm_fk_1")
  @@map("user_fcm")
}

model Lecturer {
  id          String   @id @default(uuid())
  nidn        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  email       String?  @unique @db.VarChar(50)
  numberPhone String?  @map("number_phone") @db.VarChar(50)
  lesson      String?  @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([name], map: "lecturer_fk_1")
  @@index([nidn], map: "lecturer_fk_2")
  @@map("lecturer")
}

model Generation {
  id        String    @id @default(uuid())
  year      String    @db.VarChar(20)
  isActive  Boolean   @default(true) @map("is_active")
  member    Member[]
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([year], map: "generation_fk_1")
  @@map("generation")
}

model Member {
  id           String       @id @default(uuid())
  name         String       @db.VarChar(255)
  nim          String?      @unique @db.VarChar(110)
  generationId String       @map("generation_id")
  isActive     Boolean?     @default(true) @map("is_active")
  instagram    String?      @db.VarChar(50)
  facebook     String?      @db.VarChar(50)
  twitter      String?      @db.VarChar(50)
  linkedin     String?      @db.VarChar(50)
  Generation   Generation   @relation(fields: [generationId], references: [id])
  Structural   Structural[]
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamp(0)
  User         User?        @relation

  @@index([generationId], map: "member_fk_1")
  @@map("member")
}

model Structural {
  id        String   @id @unique @default(uuid())
  jabatan   Jabatan
  image     String   @db.VarChar(255)
  memberId  String   @map("member_id") @db.VarChar(110)
  isActive  Boolean  @default(true) @map("is_active")
  Member    Member   @relation(fields: [memberId], references: [id])
  year      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([memberId], map: "struktural_fk_1")
  @@map("structural")
}

model Event {
  id                  String                @id @unique @default(uuid())
  name                String                @db.VarChar(255)
  description         String?               @db.Text
  image               String                @db.VarChar(255)
  type                EventType             @default(COMMON)
  isOpen              Boolean               @default(true) @map("is_open")
  endTime             DateTime              @default(now()) @map("end_time")
  startTime           DateTime              @default(now()) @map("start_time")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt           DateTime?             @map("deleted_at")
  NotificationHistory NotificationHistory[]
  EventRegistration   EventRegistration[]
  RegistrationType    RegistrationType[]

  @@map("event")
}

model EventMeeting {
  id          String       @id @unique @default(uuid())
  name        String       @db.VarChar(155)
  description String?      @db.VarChar(500)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamp(0)
  Meeting     Meeting[]
  Attendance  Attendance[]

  @@map("event_meeting")
}

model Meeting {
  id                  String                @id @unique @default(uuid())
  name                String                @db.VarChar(155)
  description         String?               @db.Text
  startTime           DateTime              @map("start_time") @db.Timestamp(0)
  endTime             DateTime              @map("end_time") @db.Timestamp(0)
  eventMeetingId      String                @map("event_meeting_id") @db.VarChar(110)
  classId             String?               @map("class_id") @db.VarChar(110)
  EventMeeting        EventMeeting          @relation(fields: [eventMeetingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamp(0)
  resume              String?               @db.Text
  class               Class?                @relation(fields: [classId], references: [id])
  Attendance          Attendance[]
  NotificationHistory NotificationHistory[]

  @@index([eventMeetingId], map: "meeting_fk_1")
  @@map("meeting")
}

model Attendance {
  id             Int          @id @default(autoincrement())
  image          String       @db.VarChar(255)
  userId         String       @map("user_id") @db.VarChar(110)
  meetingId      String       @map("meeting_id") @db.VarChar(110)
  eventMeetingId String       @map("event_meeting_id") @db.VarChar(110)
  coordinate     String       @db.VarChar(110)
  address        String?      @db.VarChar(255)
  attendanceTime String?      @map("attendance_time") @db.VarChar(150)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamp(0)
  User           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Meeting        Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  EventMeeting   EventMeeting @relation(fields: [eventMeetingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Point          Point[]

  @@index([userId], map: "attendance_fk_1")
  @@index([meetingId], map: "attendance_fk_2")
  @@index([eventMeetingId], map: "attendance_fk_3")
  @@map("attendance")
}

model Achievement {
  id          Int       @id @unique @default(autoincrement())
  image       String    @db.VarChar(255)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  timeDate    DateTime? @map("time_date") @db.Timestamp(0)
  timeString  String?   @map("time_string") @db.VarChar(50)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("achievement")
}

model Bussiness {
  id            Int             @id @unique @default(autoincrement())
  title         String          @db.VarChar(110)
  description   String?         @db.Text
  startPrice    Decimal         @map("start_price") @db.Decimal(60, 2)
  endPrice      Decimal         @map("end_price") @db.Decimal(60, 2)
  type          BussinessType   @default(MERCHANDISE)
  url           String?         @db.Text
  contactPerson String?         @map("contact_person") @db.VarChar(20)
  createdAt     DateTime?       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime?       @updatedAt @map("updated_at") @db.Timestamp(0)
  businessImage BusinessImage[]

  @@map("business")
}

model BusinessImage {
  id         Int       @id @unique @default(autoincrement())
  image      String    @db.VarChar(255)
  businessId Int       @map("business_id")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)
  business   Bussiness @relation(fields: [businessId], references: [id])

  @@index([businessId], map: "business_image_fk_1")
  @@map("business_image")
}

model OTP {
  id         String    @id @unique @default(uuid())
  email      String    @db.VarChar(50)
  otp        String    @db.VarChar(500)
  isVerified Boolean   @default(false) @map("is_verified")
  expired    DateTime? @db.Timestamp(0)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamp()

  @@map("otps")
}

model Point {
  id           Int        @id @default(autoincrement())
  point        Int
  userId       String     @map("user_id") @db.VarChar(110)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attendanceId Int
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt    DateTime?  @default(now()) @map("created_at")
  updatedAt    DateTime?  @updatedAt @map("updated_at")

  @@index([userId], map: "point_fk_1")
  @@index([attendanceId], map: "point_fk_2")
  @@map("points")
}

model NotificationHistory {
  id        String   @id @unique @default(uuid())
  eventId   String?  @map("acara_id") @db.VarChar(110)
  userId    String   @map("user_id") @db.VarChar(110)
  Event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  title     String   @db.VarChar(155)
  body      String   @db.Text
  isRead    Boolean  @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  meetingId String?  @map("meeting_id") @db.VarChar(110)

  @@index([eventId], map: "notification_history_fk_1")
  @@index([userId], map: "notification_history_fk_2")
  @@map("notification_history")
}

model Version {
  id             Int     @id @default(autoincrement())
  androidVersion String? @map("android_version") @db.VarChar(110)
  iosVersion     String? @map("ios_version") @db.VarChar(110)
  playstoreLink  String? @map("play_store_link") @db.VarChar(300)
  appStoreLink   String? @map("app_store_link") @db.VarChar(300)
  notes          String? @db.VarChar(500)

  @@map("version")
}

model Mentor {
  id        String   @id @unique @default(uuid())
  userId    String   @unique @map("user_id") @db.VarChar(110)
  balance   Decimal  @db.Decimal()
  instagram String?  @db.VarChar(155)
  facebook  String?  @db.VarChar(155)
  twitter   String?  @db.VarChar(155)
  linkedin  String?  @db.VarChar(155)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "mentors_fk_1")
  @@map("mentors")
}

model Category {
  id        String   @id @unique @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  class     Class[]

  @@map("categories")
}

model Class {
  id               String             @id @unique @default(uuid())
  createdBy        String             @map("created_by") @db.VarChar(110)
  name             String             @db.VarChar(255)
  description      String?            @db.Text
  status           ClassStatus        @default(DRAFT)
  thumbnail        String?            @db.VarChar(255)
  level            Level              @default(BEGINNER)
  code             String             @unique @db.Char(10)
  categoryId       String             @map("category_id") @db.VarChar(110)
  price            Decimal            @db.Decimal()
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamp(0)
  user             User               @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  category         Category           @relation(fields: [categoryId], onDelete: Cascade, onUpdate: NoAction, references: [id])
  session          Session[]
  classParticipant ClassParticipant[]
  completedClass   CompletedClass[]
  certificate      Certificate[]
  cransaction      Transaction[]
  Meeting          Meeting[]
  ClassMentor      ClassMentor[]

  @@index([createdBy], map: "classess_fk_1")
  @@map("classes")
}

model ClassMentor {
  id        String   @id @unique @default(uuid()) @db.Char(36)
  classId   String   @map("class_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  user      User     @relation(fields: [userId], references: [id], map: "class_mentor_user")
  class     Class    @relation(fields: [classId], references: [id], map: "class_mentor_class")

  @@unique([userId, classId], map: "user_class_unique")
  @@index([classId], map: "class_mentor_class_id_fkey")
  @@index([userId], map: "class_mentor_user_id_fkey")
  @@map("class_mentor")
}

model ClassParticipant {
  id        String   @id @unique @default(uuid())
  userId    String   @map("user_id") @db.VarChar(110)
  classId   String   @map("class_id") @db.VarChar(110)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([userId], map: "class_participants_fk_1")
  @@index([classId], map: "class_participants_fk_2")
  @@map("class_participants")
}

model Session {
  id        String   @id @unique @default(uuid())
  name      String   @db.VarChar(110)
  classId   String   @map("class_id") @db.VarChar(110)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  module    Module[]

  @@index([classId], map: "sessions_fk_1")
  @@map("sessions")
}

model Module {
  id              String            @id @unique @default(uuid())
  name            String            @db.VarChar(155)
  sessionId       String            @map("session_id") @db.VarChar(110)
  textModule      String?           @map("text_module") @db.Text
  videoUrl        String?           @map("video_url") @db.VarChar(255)
  fileModule      String?           @map("file_module") @db.VarChar(255)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamp(0)
  session         Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignment      Assignment?       @relation
  completedModule CompletedModule[]

  @@index([sessionId], map: "modules_fk_1")
  @@map("modules")
}

model CompletedModule {
  id        String   @id @unique @default(uuid())
  moduleId  String   @map("module_id") @db.VarChar(110)
  userId    String   @map("user_id") @db.VarChar(110)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([moduleId], map: "completed_modules_fk_1")
  @@index([userId], map: "completed_modules_fk_2")
  @@map("completed_modules")
}

model CompletedClass {
  id        String   @id @unique @default(uuid())
  classId   String   @map("module_id") @db.VarChar(110)
  userId    String   @map("user_id") @db.VarChar(110)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([classId], map: "completed_class_fk_1")
  @@index([userId], map: "completed_class_fk_2")
  @@map("completed_class")
}

model Certificate {
  id        String   @id @unique @default(uuid())
  classId   String   @map("class_id") @db.VarChar(110)
  code      String   @unique @map("certificates_code_unique")
  userId    String   @map("user_id") @db.VarChar(110)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  class     Class    @relation(fields: [classId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([classId], map: "certificates_fk_1")
  @@index([userId], map: "certificates_fk_2")
  @@map("certificates")
}

model Assignment {
  id               String         @id @unique @default(uuid())
  title            String         @db.VarChar(255)
  description      String?        @db.Text
  moduleId         String         @unique @map("module_id") @db.VarChar(110)
  dueDate          DateTime       @map("due_date") @db.Date
  allowedFile      String?        @map("allowed_file") @db.VarChar(10)
  type             AssignmentType @default(FILE)
  isFinalAssigment Boolean        @default(false) @map("is_final_assignment") @db.Boolean
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamp(0)
  module           Module?        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submission       Submission[]

  @@index([moduleId], map: "assignments_fk_1")
  @@map("assignments")
}

model Submission {
  id           String           @id @unique @default(uuid())
  assignmentId String           @map("assignment_id") @db.VarChar(110)
  userId       String           @map("user_id") @db.VarChar(110)
  status       SubmissionStatus @default(REVIEW)
  file         String
  feedback     String?          @db.Text
  actionBy     String?          @map("action_by") @db.VarChar(110)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamp(0)
  participant  User             @relation("submission_participant", fields: [userId], references: [id], onDelete: Cascade)
  mentor       User?            @relation("submission_mentor", fields: [actionBy], references: [id], onDelete: Cascade)
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId], map: "submissions_fk_1")
  @@index([userId], map: "submissions_fk_2")
  @@map("submissions")
}

model Transaction {
  id            String            @id @unique @default(uuid())
  uniqueCode    String            @unique @map("unique_code")
  classId       String            @map("class_id") @db.VarChar(110)
  userId        String            @map("user_id") @db.VarChar(110)
  status        TransactionStatus @default(PENDING)
  amount        Decimal           @db.Decimal()
  signatureKey  String?           @map("signature_key")
  paymentMethod String?           @map("payment_method") @db.VarChar(255)
  paymentTime   DateTime?         @map("payment_time")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamp(0)
  class         Class             @relation(fields: [classId], references: [id], onDelete: NoAction)
  user          User              @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@unique([uniqueCode], map: "transactions_unique_pk_1")
  @@index([classId], map: "transactions_fk_1")
  @@index([userId], map: "transactions_fk_2")
  @@map("transactions")
}

model History {
  id         String        @id @unique @default(uuid()) @db.Char(36)
  title      String
  flag       HistoryFlag
  module     HistoryModule
  statusCode String?       @map("status_code")
  endpoint   String?
  actionId   String?       @map("action_id")
  createdBy  String?       @map("created_by")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamp(0)

  user User? @relation(fields: [createdBy], references: [id])

  @@index([createdBy], map: "history_created_by_fk_1")
  @@map("histories")
}

model RegistrationType {
  id       String                    @id @unique @default(cuid())
  name     String
  year     Int
  type     RegistrationEventTypeEnum @default(LEARNING_GROUP)
  isActive Boolean                   @map("is_active")
  eventId  String?                   @map("event_id")

  event     Event?   @relation(fields: [eventId], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("registration_type")
}

model EventRegistration {
  id                 String   @id @unique @default(cuid())
  name               String
  nim                String?
  class              String?
  generation         Int?
  categoryId         String?  @map("category_id")
  image              String?
  registrationTypeId String?  @map("registration_type_id")
  userId             String?  @map("user_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  user               User?    @relation(fields: [userId], references: [id])
  Event              Event?   @relation(fields: [eventId], references: [id])
  eventId            String?

  @@map("event_registration")
}

model TicketSuport {
  id          String   @id @unique @default(uuid()) @db.Char(36)
  title       String
  description String   @db.Text
  file        String
  reportBy    String   @map("report_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  reporter User @relation(fields: [reportBy], references: [id])

  @@index([reportBy], map: "ticket_support_report_by_fk_1")
  @@map("ticket_suport")
}

enum HistoryModule {
  USER
  EVENT
  EVENT_MEETING
  MEETING
  MEMBER
  AUTH
  VERSION
  CLASS
  MENTOR
  LECTURER
  SYSTEM
}

enum HistoryFlag {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ERROR
  REJECT
