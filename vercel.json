{
  "version": 2,
 "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**"],
        "commands": {
          "build": "prisma generate && tsc"
        }
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/testing-cronjob",
      "schedule": "12 21 * * *"
    },
    {
      "path": "/",
      "schedule": "12 21 * * *"
    }
  ]
}
