# HIMTI API - contoh environment variables.
# Bagian pertama adalah variabel yang di-set di Vercel production
# (27 variabel). Bagian kedua adalah variabel yang dibaca kode tapi
# TIDAK di-set di production. Nama saja, tanpa nilai. Jangan pernah
# menulis nilai asli ke file ini.

# CORS (production wajib persis 4 origin ini, dipisah koma)
CORS_ALLOWED_ORIGINS=https://lms.himtiumt.org,https://cms.himtiumt.org,https://himtiumt.org,https://www.himtiumt.org

# Database
DATABASE_URL=postgresql://username:password@host:5432/database_name

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES=3d

# Security
CRYPTO_SECRET_KEY=your_crypto_secret_key
SECRET_KEY=your_secret_key
HEADER_KEY=X-Api-Key

# Application
PORT=8080
UNDER_MAINTENANCE=NO
ANGGOTA_CODE=HIMTI091011

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# SMTP
SMTP_LOGIN=your_smtp_login
SMTP_PORT=587
SMTP_HOST=smtp-relay.brevo.com
SMTP_PASSWORD=your_smtp_password
SMTP_USER=your_email@example.com

# Email
EMAIL_SENDER=noreply@example.com

# Storage
AWS_STORAGE_SECRET_KEY=your_storage_secret_key
AWS_STORAGE_ACCESS_KEY=your_storage_access_key
AWS_STORAGE_ENDPOINT=https://your-project.storage.supabase.co/storage/v1
AWS_STORAGE_REGION=ap-southeast-1
AWS_STORAGE_BUCKET=your_storage_bucket
AWS_STORAGE_BUCKET_FOLDER=production

# Dokumen dan AI (dipakai kode dan di-set di production)
CLOUDCONVERT_API_KEY=your_cloudconvert_api_key
REPLICATE_API_TOKEN=your_replicate_api_token

# ---------------------------------------------------------------------------
# Dibaca kode, tapi TIDAK di-set di Vercel production. Jangan jadikan ini
# contoh nilai production. Kalau fitur di bawah dipakai di production,
# variabelnya harus ditambahkan dulu di Vercel.
# ---------------------------------------------------------------------------

# Midtrans (pembuatan transaksi kelas berbayar). Tanpa SERVER_KEY dan
# SNAP_URL, pembuatan transaksi gagal.
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v1/transactions

# LibreOffice (opsional, hanya override path binary lokal; production
# memakai CloudConvert, jadi variabel ini tidak diperlukan di sana).
LIBREOFFICE_PATH=/usr/bin/libreoffice
