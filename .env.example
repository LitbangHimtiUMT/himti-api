# SMTP
SMTP_LOGIN=your_smtp_login
SMTP_PORT=587
SMTP_HOST=smtp-relay.brevo.com
SMTP_PASSWORD=your_smtp_password
SMTP_USER=your_email@example.com

# Storage
AWS_STORAGE_SECRET_KEY=your_storage_secret_key
AWS_STORAGE_ACCESS_KEY=your_storage_access_key
AWS_STORAGE_ENDPOINT=https://your-project.storage.supabase.co/storage/v1
AWS_STORAGE_REGION=ap-southeast-1
AWS_STORAGE_BUCKET_FOLDER=production

# Email
EMAIL_SENDER=noreply@example.com

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES=3d

# Security
CRYPTO_SECRET_KEY=your_crypto_secret_key
SECRET_KEY=your_secret_key
HEADER_KEY=X-Api-Key

# Application
PORT=8080
UNDER_MAINTENANCE=NO
ANGGOTA_CODE=HIMTI091011

# Database
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com